# Public mode is the default: Wikipedia/Wikivoyage search without an API key.
# The GitHub Pages workflow sets these values for the published site.
VITE_SEARCH_MODE=public
VITE_BASE_PATH=/

# Optional full server mode only: set VITE_SEARCH_MODE=server and run dev:server.
# SearXNG needs JSON output enabled. Example: http://localhost:8080
SEARXNG_URL=
PORT=3001

# Optional hosted provider for server mode; takes precedence over SearXNG.
# No key is needed for public mode. Never put secrets in VITE_ variables.
TAVILY_API_KEY=

# Optional Docker service secret; generate your own as described in README.md.
# SEARXNG_SECRET=
