# Public mode is the default: India snapshot + public Wiki guides, without API keys.
# GitHub Actions refreshes the snapshot periodically; no hosted backend is needed.
# The Pages workflow sets VITE_BASE_PATH=/finder/ for the published site.
VITE_SEARCH_MODE=public
VITE_BASE_PATH=/

# Optional full server mode only: set VITE_SEARCH_MODE=server and run dev:server.
# SearXNG needs JSON output enabled. Example: http://localhost:8080
SEARXNG_URL=
PORT=3001

# Optional hosted provider for server mode; takes precedence over SearXNG.
# No key is needed for public mode or scheduled collection.
# Never put secrets in VITE_ variables.
TAVILY_API_KEY=

# Optional Docker service secret; generate your own as described in README.md.
# SEARXNG_SECRET=

# Optional place collector endpoint override; empty uses the public Overpass API.
OVERPASS_URL=
OVERPASS_USER_AGENT=

# Optional local evidence API only. Pages does not use these credentials.
DDGS_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
